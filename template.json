{
  "name": "CI4 FAQ",
  "slug": "ci4-faq",
  "repo": "dcardenasl/ci4-faq-domain",
  "type": "platform-template",
  "version": "1.0.0",
  "description": "Full-stack FAQ template for ci4-platform with hub, admin, and domain repos.",
  "components": [
    {
      "role": "hub",
      "path": "ci4-faq-hub",
      "repo_name": "ci4-faq-hub"
    },
    {
      "role": "domain",
      "path": "ci4-faq-domain",
      "repo_name": "ci4-faq-domain"
    }
  ],
  "defaults": {
    "ports": {
      "hub": 8080,
      "admin": 8082,
      "domain": 8090
    },
    "databases": {
      "hub": "ci4_faq_hub",
      "hub_test": "ci4_faq_hub_test",
      "domain": "ci4_faq_domain",
      "domain_test": "ci4_faq_domain_test"
    },
    "domain_app_code": "ci4-faq-domain"
  },
  "entities": [
    {
      "name": "FaqCategory",
      "resource": "faq-categories",
      "api_path": "/support/faq-categories",
      "title": "FAQ Categories",
      "fields": [
        { "name": "name", "type": "string", "label": "Name", "placeholder": "Enter category name", "help": "Used in the FAQ category listings.", "required": true },
        { "name": "slug", "type": "string", "label": "Slug", "placeholder": "faq-category-name", "help": "URL-safe identifier for the category.", "required": true },
        { "name": "is_active", "type": "boolean", "label": "Active", "help": "Activate or deactivate this FAQ category.", "default": true }
      ]
    },
    {
      "name": "Faq",
      "resource": "faqs",
      "api_path": "/support/faqs",
      "title": "FAQs",
      "fields": [
        { "name": "question", "type": "string", "label": "Question", "placeholder": "How do I reset my password?", "help": "Short, searchable question text.", "required": true },
        { "name": "answer", "type": "text", "label": "Answer", "placeholder": "Write the full answer...", "help": "Expanded answer shown to users.", "required": true },
        { "name": "category_id", "type": "integer", "label": "Category ID", "help": "Pick the FAQ category that best fits this question.", "required": true },
        { "name": "is_published", "type": "boolean", "label": "Published", "help": "Publish this FAQ entry to make it visible.", "default": false },
        { "name": "sort_order", "type": "integer", "label": "Sort Order", "help": "Lower values appear first in the list.", "required": true }
      ]
    }
  ],
  "permissions": [
    { "code": "items.read",           "roles": ["user", "admin", "superadmin"] },
    { "code": "faq-category.read",    "roles": ["user", "admin", "superadmin"] },
    { "code": "faq-category.write",   "roles": ["admin", "superadmin"] },
    { "code": "faq-category.delete",  "roles": ["superadmin"] },
    { "code": "faq.read",             "roles": ["user", "admin", "superadmin"] },
    { "code": "faq.write",            "roles": ["admin", "superadmin"] },
    { "code": "faq.delete",           "roles": ["superadmin"] }
  ],
  "mirror_to_hub": true,
  "admin_modules": [
    {
      "resource": "FaqCategory",
      "module": "FaqCategory",
      "api_path": "/support/faq-categories",
      "service": "domain",
      "fields": "name:string:required,slug:string:required,is_active:boolean"
    },
    {
      "resource": "Faq",
      "module": "Faq",
      "api_path": "/support/faqs",
      "service": "domain",
      "fields": "question:string:required,answer:text:required,category_id:relation:required:faq-categories,is_published:boolean,sort_order:int:required"
    }
  ],
  "admin_sidebar": [
    {
      "module": "FaqCategory",
      "label": "Faq.sidebar_label",
      "icon": "help-circle",
      "permission": "faq.read",
      "items": ["FaqCategory", "Faq"]
    }
  ]
}
